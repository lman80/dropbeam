<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keys shared by macOS AND iOS. Tauri merges this file into BOTH the macOS
       bundle and the iOS app (gen/apple/app_iOS/Info.plist). macOS-only keys
       (LSUIElement, folder prompts, Services) live in Info.macos.plist
       (tauri.conf.json → bundle.macOS.infoPlist) so they never ship in the
       iPhone app. -->

  <!-- DropBeam's own end-to-end encryption (QUIC/TLS + Noise-style keys from
       iroh/rustls) is standard crypto that is NOT provided by Apple's OS, so it
       is not the "exempt" kind. App Store Connect then asks the export-compliance
       questions per build (answer: standard algorithms; see docs/APPSTORE.md). -->

  <!-- Camera: video calls, and QR scanning for friend, device and shared-folder codes. -->
  <key>NSCameraUsageDescription</key>
  <string>DropBeam uses the camera for video calls with your friends and to scan QR codes for adding friends, linking your devices and joining shared folders.</string>

  <!-- Microphone: audio and video calls (straight between the two devices). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>DropBeam uses the microphone for audio and video calls with your friends. Calls go straight between your devices.</string>

  <!-- Saving a received photo/video to the library from the share sheet. -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>DropBeam saves photos and videos you choose to keep to your photo library.</string>

  <!-- iroh's mDNS peer discovery (N0_SERVICE_NAME). Without BOTH of these the OS
       silently drops multicast and LAN peers never appear (macOS 15+ and iOS). -->
  <key>NSBonjourServices</key>
  <array><string>_irohv1._udp</string><string>_dropbeam._udp</string></array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>DropBeam looks for your devices and friends on this network so files go straight between them at full speed, without the internet.</string>

  <!-- Open in place: AVPlayer and previews stream a friend's file from
       DropBeam's own server on 127.0.0.1 (plain HTTP, never leaves the device). -->
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
