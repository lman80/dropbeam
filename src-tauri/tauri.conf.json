{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DropBeam",
  "mainBinaryName": "DropBeam",
  "version": "0.10.1",
  "identifier": "com.dropbeam.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DropBeam",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      },
      {
        "label": "popover",
        "url": "index.html",
        "width": 300,
        "height": 390,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "hud",
        "url": "index.html",
        "width": 340,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "public.app-category.utilities",
    "shortDescription": "Seamless peer-to-peer file transfer",
    "longDescription": "DropBeam sends files directly between computers — on your local network or across the internet — with end-to-end encryption. Includes Shared Drop Folders that auto-beam files to a paired friend.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMjA5QjkyRjQwQUY5QzMKUldURCtRcjBrcHNnSVFNeGVyZHlDd3o0MTlVSjcwRi81bzZXcDN4dy9NUEFjbXN0OUMxTmRLQjAK",
      "endpoints": [
        "https://github.com/lman80/dropbeam/releases/latest/download/latest.json"
      ]
    }
  }
}
