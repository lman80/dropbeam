<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime apps can only use the camera with this entitlement; without it
	     macOS denies getUserMedia silently and never shows the permission prompt. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
